# ============================================
# 配置说明
# ============================================
# 本文件包含多种配置方案示例
# 请根据你的需求，取消注释（删除 # 号）相应的配置方案
# 只保留一个方案生效，其他方案请注释掉
# 
# 配置继承说明：
# - Vision 配置如果留空，会自动继承 LLM 的配置
# - Embedding 配置如果留空，会自动继承 LLM 的配置
# - Rerank 配置如果留空，则不使用 rerank 功能
# ============================================

# ============================================
# 方案 1: 全部使用 Qwen（云服务）
# ============================================
# 适用场景：使用阿里云通义千问的完整方案
# 优点：国内访问速度快，价格相对便宜
# 
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen-turbo
# LLM_API_KEY=sk-your-qwen-api-key-here
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 
# # Vision 配置（继承 LLM 配置，可留空）
# VISION_PROVIDER=
# VISION_MODEL=
# VISION_API_KEY=
# VISION_BASE_URL=
# 
# # Embedding 配置（继承 LLM 配置，可留空）
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=
# EMBEDDING_DIM=1536
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ============================================
# 方案 2: 全部使用 OpenAI（云服务）
# ============================================
# 适用场景：使用 OpenAI 的完整方案
# 优点：模型质量高，功能强大
# 
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-your-openai-api-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# 
# # Vision 配置（继承 LLM 配置，可留空）
# VISION_PROVIDER=
# VISION_MODEL=
# VISION_API_KEY=
# VISION_BASE_URL=
# 
# # Embedding 配置（继承 LLM 配置，可留空）
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ============================================
# 方案 3: 全部使用 Ollama（本地）
# ============================================
# 适用场景：完全本地部署，数据不出本地
# 优点：数据安全，无 API 费用，可离线使用
# 注意：需要先安装并启动 Ollama，下载相应模型
# 
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434
# 
# # Vision 配置（继承 LLM 配置，可留空）
# VISION_PROVIDER=
# VISION_MODEL=llava:latest
# VISION_API_KEY=
# VISION_BASE_URL=
# 
# # Embedding 配置（继承 LLM 配置，可留空）
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=bge-m3:latest
# EMBEDDING_DIM=1024
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ============================================
# 方案 4: 混合方案 - Qwen LLM + Ollama Embedding
# ============================================
# 适用场景：LLM 用云服务保证质量，Embedding 用本地节省成本
# 优点：平衡性能和成本，Embedding 调用频繁，本地可节省大量费用
# 
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen-turbo
# LLM_API_KEY=sk-your-qwen-api-key-here
# 国外请放开以下这条： 
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 国内请放开以下这条： 
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 
# # Vision 配置（继承 LLM 配置，使用 Qwen）
# VISION_PROVIDER=
# VISION_MODEL=
# VISION_API_KEY=
# VISION_BASE_URL=
# 
# # Embedding 配置（独立配置，使用本地 Ollama）
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3:latest
# EMBEDDING_DIM=1024
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=http://localhost:11434

# ============================================
# 方案 5: 混合方案 - OpenAI LLM + Ollama Embedding
# ============================================
# 适用场景：LLM 用 OpenAI 保证质量，Embedding 用本地节省成本
# 优点：LLM 质量高，Embedding 本地化节省费用
# 
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-your-openai-api-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# 
# # Vision 配置（继承 LLM 配置，使用 OpenAI）
# VISION_PROVIDER=
# VISION_MODEL=
# VISION_API_KEY=
# VISION_BASE_URL=
# 
# # Embedding 配置（独立配置，使用本地 Ollama）
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3:latest
# EMBEDDING_DIM=1024
# EMBEDDING_BASE_URL=http://localhost:11434

# ============================================
# 方案 6: 混合方案 - Qwen LLM + OpenAI Embedding
# ============================================
# 适用场景：LLM 用 Qwen 节省成本，Embedding 用 OpenAI 保证质量
# 优点：平衡成本和性能
# 
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen-turbo
# LLM_API_KEY=sk-your-qwen-api-key-here
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 
# # Vision 配置（继承 LLM 配置，使用 Qwen）
# VISION_PROVIDER=
# VISION_MODEL=
# VISION_API_KEY=
# VISION_BASE_URL=
# 
# # Embedding 配置（独立配置，使用 OpenAI）
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072
# EMBEDDING_API_KEY=sk-your-openai-api-key-here
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# ============================================
# 方案 7: 使用 LM Studio（本地 OpenAI 兼容 API）
# ============================================
# 适用场景：使用 LM Studio 本地运行模型
# 优点：本地部署，支持多种模型格式
# 注意：需要先安装并启动 LM Studio
# 
# LLM_PROVIDER=lmstudio
# LLM_MODEL=local-model
# LLM_API_KEY=lm-studio
# LLM_BASE_URL=http://localhost:1234/v1
# 
# # Vision 配置（继承 LLM 配置，可留空）
# VISION_PROVIDER=
# VISION_MODEL=
# VISION_API_KEY=
# VISION_BASE_URL=
# 
# # Embedding 配置（继承 LLM 配置，可留空）
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=local-embed-model
# EMBEDDING_DIM=1536
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ============================================
# 当前生效的配置方案（请取消注释其中一个方案）
# ============================================
# 默认使用方案 4: Qwen LLM + Ollama Embedding（混合方案）
LLM_PROVIDER=qwen
LLM_MODEL=qwen-turbo
LLM_API_KEY=sk-your-qwen-api-key-here
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Vision 配置（继承 LLM 配置）
VISION_PROVIDER=
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=

# Embedding 配置（独立配置，使用本地 Ollama）
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434

# ============================================
# Rerank 配置 (可选，默认不使用)
# ============================================
# 如果留空，则不使用 rerank 功能
RERANK_PROVIDER=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_BASE_URL=

# ============================================
# 服务器配置（所有方案共用）
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# 存储配置（所有方案共用）
# ============================================
STORAGE_DIR=../data/storage
UPLOAD_DIR=../data/uploads
OUTPUT_DIR=../data/output

# ============================================
# 文档处理配置（所有方案共用）
# ============================================
MAX_CONCURRENT_FILES=2
